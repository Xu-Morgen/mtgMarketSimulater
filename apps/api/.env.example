APP_ENV=development
PORT=3001
SQLITE_PATH=./data/market-simulator.db
WEB_ORIGIN=http://localhost:3000
# 多个浏览器来源以英文逗号分隔；未设置时仅允许 WEB_ORIGIN。
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Shanghai
# 每日工作资金按此规则版本快照；版本切换只影响之后由 daily.rollover 开放的自然日。
DAILY_WORK_FUNDING_RULE_VERSION=daily-work-funds/v1
# 至少 32 字符的随机服务端密钥；不可使用 NEXT_PUBLIC_ 前缀或提交到仓库。
AUTH_JWT_SECRET=R+t961CEZ9EC4HuS3hwF4KpSgbUlgCiy9D+ofYJQmf7oo1I+IRYku76w0vZUltc0
# 短期 access token 与可撤销 refresh Cookie 的生存时间（秒）。
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Scryfall 仅由 catalog.sync 后台任务访问；启用系列为空时任务会安全拒绝导入。
CATALOG_DATA_DIR=./data/catalog
SCRYFALL_BULK_ENDPOINT=https://api.scryfall.com/bulk-data/default-cards
# 标识服务端应用；请替换 contact 中的联系邮箱，Scryfall 会拒绝 Node 默认 User-Agent。
SCRYFALL_USER_AGENT=MTG-Market-Simulator/0.1 (contact: nemo5754@outlook.com)
CATALOG_ENABLED_SET_CODES=BRO,SOS,ONE
# MTGJSON 仅由 prices.sync 后台任务访问；AllPrintings 用于把 MTGJSON UUID/工艺准确映射到本地 Scryfall SKU。
MTGJSON_PRICES_ENDPOINT=https://mtgjson.com/api/v5/AllPricesToday.json.gz
MTGJSON_PRINTINGS_ENDPOINT=https://mtgjson.com/api/v5/AllPrintings.json.gz
MTGJSON_USER_AGENT=MTG-Market-Simulator/0.1 (contact: nemo5754@outlook.com)
# Leyline 只允许报名服务端调用；超时/重试和允许 schema 均由 API 控制，浏览器不可访问。
# 当前 Provider 使用 POST https://api.mtgleyline.com/api/deck-ranking/analyze，响应可将 missingCards 置为 null。
LEYLINE_ENDPOINT=https://api.mtgleyline.com/api/deck-ranking/analyze
LEYLINE_TIMEOUT_MS=5000
LEYLINE_MAX_RETRIES=1
# 仅用于手动真实 Provider 集成测试；默认不调用外部服务。
LEYLINE_INTEGRATION_TEST=0
# 使用 `openssl rand -base64 32` 生成；只用于加密 Leyline 完整响应，绝不可放 NEXT_PUBLIC_。
DECK_RESPONSE_ENCRYPTION_KEY=8x/Rh9wOUdZmpEzNbEB+AOnSteSYwxWTzG8Zf7uxoqQ=
# I31B 备份与导出（纯服务端，运行时数据绝不进 git 或镜像）。
# 备份目录与保留策略：至少保留 N 份成功备份；定时备份失败只追加 failed 记录，绝不删最近成功备份。
BACKUP_DIR=./data/backups
BACKUP_RETENTION=7
BACKUP_INTEGRITY_CHECK=true
# 玩家经营报表导出目录与文件有效期（秒）；过期文件不可下载。
EXPORT_DIR=./data/exports
EXPORT_TTL_SECONDS=600
