# ───────────────────────────────────────────────────────────────────────────
# MTG Market Simulator 容器部署环境变量示例。
#
# 用法：cp .env.docker.example .env.docker，填好后 docker compose 读取。
# 真实密钥只在服务器本地填写，绝不提交仓库，绝不发送给浏览器。
# 生成强随机密钥：openssl rand -base64 32
# ───────────────────────────────────────────────────────────────────────────

# 对外访问地址（含协议/端口，供 API 组装 CORS 白名单与回跳；有域名时填 https 域名）。
WEB_ORIGIN=http://localhost:3000
# 多个来源以英文逗号分隔；代理模式下通常与本站同源。
CORS_ORIGINS=http://localhost:3000
# Web 对外暴露的宿主机端口（compose 中 WEB_PORT）。
WEB_PORT=3000

# 认证密钥：务必替换为随机 32+ 字符值，且不可使用示例值（zod 会拒绝示例值）。
AUTH_JWT_SECRET=
# 短期 access token 与可撤销 refresh cookie 的生存时间（秒）。
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Leyline 完整响应的加密密钥：32 字节 base64（生产必须替换默认值）。
# 生成方式：openssl rand -base64 32
DECK_RESPONSE_ENCRYPTION_KEY=

# 玩家时区（影响业务日切、每日资金等展示与计算边界）。
APP_TIMEZONE=Asia/Shanghai
# 每日工作资金按此规则版本快照；版本切换只影响之后开放的自然日。
DAILY_WORK_FUNDING_RULE_VERSION=daily-work-funds/v1

# 启用的卡牌系列（留空则目录同步任务安全拒绝导入）。按需调整。
CATALOG_ENABLED_SET_CODES=BRO,SOS,ONE

# 外部数据源（仅由 API 后台任务访问，浏览器不触发）。
SCRYFALL_BULK_ENDPOINT=https://api.scryfall.com/bulk-data/default-cards
SCRYFALL_USER_AGENT=MTG-Market-Simulator/0.1 (contact: your-email@example.com)
MTGJSON_PRICES_ENDPOINT=https://mtgjson.com/api/v5/AllPricesToday.json.gz
MTGJSON_PRINTINGS_ENDPOINT=https://mtgjson.com/api/v5/AllPrintings.json.gz
MTGJSON_ALLPRICES_ENDPOINT=https://mtgjson.com/api/v5/AllPrices.json.gz
MTGJSON_USER_AGENT=MTG-Market-Simulator/0.1 (contact: your-email@example.com)

# Leyline 报名评分 Provider（仅服务端调用）。
LEYLINE_ENDPOINT=https://api.mtgleyline.com/api/deck-ranking/analyze
LEYLINE_TIMEOUT_MS=5000
LEYLINE_MAX_RETRIES=1
LEYLINE_INTEGRATION_TEST=0

# 注：SQLite 路径与端口由 docker-compose.yml 固定注入，此处不需要设置。
# 注：AI 叙事模块 I33 发布后才启用；启用时在 apps/ai 配置 OPENAI_API_KEY，不在本文件。
